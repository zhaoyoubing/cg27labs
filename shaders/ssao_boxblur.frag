#version 330 core


out float fragColor;
in vec2 v_TexCoord;

uniform sampler2D u_SSAOTexture;
uniform sampler2D u_DepthTexture; 
uniform vec2 u_TexelSize;         // e.g., vec2(1.0 / screenWidth, 1.0 / screenHeight)

void main() {
    float centerDepth = texture(u_DepthTexture, v_TexCoord).r;
    float centerAO    = texture(u_SSAOTexture, v_TexCoord).r;

    float cumulativeAO = 0.0;
    float totalWeight  = 0.0;

    // Define a 5x5 neighborhood (-2 to 2)
    int radius = 2;
    
    for (int x = -radius; x <= radius; ++x) {
        for (int y = -radius; y <= radius; ++y) {
            // Calculate offset coordinate
            vec2 offset = vec2(float(x), float(y)) * u_TexelSize;
            vec2 sampleCoord = v_TexCoord + offset;

            // Sample neighboring depth and AO
            float sampleDepth = texture(u_DepthTexture, sampleCoord).r;
            float sampleAO    = texture(u_SSAOTexture, sampleCoord).r;

            // --- The Bilateral Edge-Aware Check ---
            // Measure the depth difference between the center and the neighbor
            float depthDiff = abs(centerDepth - sampleDepth);
            
            // If the depth difference is small, weight is 1.0. 
            // If it exceeds a threshold (e.g., 0.05), weight drops to 0.0 (ignoring it across edges).
            float weight = smoothstep(0.05, 0.0, depthDiff);

            cumulativeAO += sampleAO * weight;
            totalWeight  += weight;
        }
    }

    // Normalize and prevent division by zero
    fragColor = (totalWeight > 0.0) ? (cumulativeAO / totalWeight) : centerAO;
}